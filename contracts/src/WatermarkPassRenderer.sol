import {IWatermarkPassRenderer} from "./interfaces/IWatermarkPassRenderer.sol";

/// @title WatermarkPassRenderer
/// @notice The Watermark Genesis Pass artwork, fully on-chain: a cream postage stamp with a Mumbai landmark engraved in
/// ink, a saffron "FEE PAID" postmark placed from the token id, and the edition number "#042 / 100". Stateless.
/// Tokens 1-20 show the Gateway of India, 21-40 the Rajabai Clock Tower, 41-60 the Bandra-Worli Sea Link, 61-80
/// Chhatrapati Shivaji Terminus and 81-100 Marine Drive.
///
/// The strings are generated from script/pass-art/generator.mjs, the single source of truth for the art.
/// test/fixtures/pass-svg/<id>.svg is the generator's output, and WatermarkPassRenderer.t.sol checks svg(id) against
/// it byte for byte for every id. The SVG loads nothing: every href is a fragment inside the document, and it uses
/// system fonts only.
contract WatermarkPassRenderer is IWatermarkPassRenderer {
    uint256 public constant MAX_TOKEN_ID = 100;
    /// @dev Each landmark plate covers 20 consecutive ids.
    uint256 internal constant PER_PLATE = 20;

    error TokenOutOfRange(uint256 tokenId);

    /// @inheritdoc IWatermarkPassRenderer
    function svg(uint256 tokenId) external pure returns (string memory) {
        (string memory plate, string memory name, string memory coord) = _plate(_plateIndex(tokenId));
        // Three short concats: one call with all eleven parts is too deep for the legacy code generator.
        string memory s = string.concat(HEAD, plate, MID, name);
        s = string.concat(s, MID2, coord, PM_HEAD, _postmark(tokenId));
        return string.concat(s, PM_TAIL, _threeDigits(tokenId), TAIL);
    }

    /// @inheritdoc IWatermarkPassRenderer
    function landmark(uint256 tokenId) external pure returns (string memory) {
        uint256 i = _plateIndex(tokenId);
        if (i == 0) return "Gateway of India";
        if (i == 1) return "Rajabai Clock Tower";
        if (i == 2) return "Bandra-Worli Sea Link";
        if (i == 3) return "Chhatrapati Shivaji Terminus";
        return "Marine Drive";
    }

    function _plateIndex(uint256 tokenId) internal pure returns (uint256) {
        if (tokenId == 0 || tokenId > MAX_TOKEN_ID) revert TokenOutOfRange(tokenId);
        return (tokenId - 1) / PER_PLATE;
    }

    /// @dev The engraving, the caption under the window and the coordinates in the top right corner.
    function _plate(uint256 i) internal pure returns (string memory, string memory, string memory) {
        if (i == 0) return (PLATE_0, NAME_0, COORD_0);
        if (i == 1) return (PLATE_1, NAME_1, COORD_1);
        if (i == 2) return (PLATE_2, NAME_2, COORD_2);
        if (i == 3) return (PLATE_3, NAME_3, COORD_3);
        return (PLATE_4, NAME_4, COORD_4);
    }

    /// @dev "translate(cx cy) rotate(r)" for the postmark, with the generator's formulas. Each value has three digits:
    /// cx is 404..492, cy 404..449 and r 348..384, so every pass gets its own postmark position.
    function _postmark(uint256 id) internal pure returns (string memory) {
        uint256 cx = 404 + ((id * 37) % 9) * 11;
        uint256 cy = 404 + ((id * 29) % 6) * 9;
        uint256 r = 348 + ((id * 47) % 37);
        return string.concat("translate(", _threeDigits(cx), " ", _threeDigits(cy), ") rotate(", _threeDigits(r), ")");
    }

    /// @dev 7 -> "007", 42 -> "042", 100 -> "100". Callers pass values below 1000.
    function _threeDigits(uint256 v) internal pure returns (string memory) {
        bytes memory b = new bytes(3);
        // forge-lint: disable-next-line(unsafe-typecast) each digit is 48..57
        b[0] = bytes1(uint8(48 + v / 100));
        // forge-lint: disable-next-line(unsafe-typecast) each digit is 48..57
        b[1] = bytes1(uint8(48 + (v / 10) % 10));
        // forge-lint: disable-next-line(unsafe-typecast) each digit is 48..57
        b[2] = bytes1(uint8(48 + v % 10));
        return string(b);
    }

