# Copy to .env and fill in locally. Never commit .env.

# --- Whitechain Sepolia (main chain) ---
# Primary RPC per Whitechain's flyer; backup: https://rpc.testnet.whitechain.io
WHITECHAIN_RPC=https://rpc.ankr.com/whitechain_testnet
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_EXPLORER=https://explorer.testnet.whitechain.io
# Official test USDT, the only one that counts (6 decimals, permit + EIP-3009). Get it by swapping WBT on YetiTrade.
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7

# --- Keys (local only) ---
# Relayer: pays gas. Fund with test WBT from https://faucet.testnet.whitechain.io (2 WBT/day, GitHub account > 30 days)
RELAYER_PRIVATE_KEY=
# Session signer: signs EIP-712 sessions off-chain. Separate key from the relayer.
SESSION_SIGNER_KEY=
SESSION_SIGNER_ADDRESS=
# Business wallet that funds demo users with USDT
BUSINESS_PRIVATE_KEY=
# Deployer for contracts
DEPLOYER_PRIVATE_KEY=
# Prover decrypt key: absolute path OUTSIDE the repo. The public half is prover/keys/prover_pub.pem
PROVER_DECRYPT_KEY_PATH=

# --- Deployed addresses (also committed in deployments/*.json) ---
REGISTRY_ADDRESS=
VERIFIER_ADDRESS=
SPONSOR_ADDRESS=
DEVNET_REGISTRY_ADDRESS=
PAYMASTER_ADDRESS=

# --- Alt mempool devnet (EF track); confirm URLs at kickoff ---
ALTMEMPOOL_EXEC_RPC=https://altmempool.forshtat.com
# The gateway has the faucet and explorer methods; altmempool.forshtat.com/rpc does not
ALTMEMPOOL_SIDECAR_RPC=https://altmempoolgateway.forshtat.com/rpc
ALTMEMPOOL_CHAIN_ID=1337
ALTMEMPOOL_EXPLORER=https://explorer.altmempool.wtf
ALTMEMPOOL_STAKING_REGISTRY=0xd51c04d7a0b01124e84de152f4e56d9eecb22d2f
# Your own devnet key (never the shared genesis key)
DEVNET_PRIVATE_KEY=

# --- Services ---
RELAYER_PORT=8788
PROVER_PORT=8787
# --- Prover (prover/README.md) ---
# The relayer's session signer address(es). Dev: the public test signer 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ALLOWED_SESSION_SIGNERS=
# Where the prover sends finished proofs (POST /stamp). Unset = keep proofs, don't stamp (dev)
RELAYER_URL=http://localhost:8788
# Compiled circuit (cd circuits && nargo compile)
CIRCUIT_PATH=circuits/target/watermark.json
# Policies the prover serves, comma-separated
POLICY_FILES=policies/test.json,policies/live.json
CA_KEYS_PATH=policies/ca-keys.json
# appIds the relayer signs sessions for (comma-separated decimals, from registerApp)
APP_IDS=
# Website origins allowed to call the relayer
CORS_ORIGINS=http://localhost:3000
# Layer 0 limits: sessions cost no gas but are still capped
SESSIONS_PER_MINUTE_PER_IP=10
MAX_OPEN_SESSIONS=5000
# LAN URL of the prover, put into the QR (e.g. http://192.168.x.x:8787)
PROVER_URL=
# Website (web/). NEXT_PUBLIC_* values are public: they are built into the page. Restart the web server after changing.
# Relayer URL the browser calls (on the phone fallback, use the Mac's LAN URL and add the site's origin to CORS_ORIGINS)
NEXT_PUBLIC_RELAYER_URL=http://localhost:8788
# appId the website asks sessions for (decimal string; must be in APP_IDS; dev value 12345; new one per demo run)
NEXT_PUBLIC_APP_ID=
# 1874 = Whitechain Sepolia (default), 1337 = alt mempool devnet
NEXT_PUBLIC_CHAIN_ID=1874
# Optional: the relayer's LAN URL; when set, /verify offers a short-link QR (Watermark Tap doesn't support it yet)
NEXT_PUBLIC_RELAYER_LAN_URL=
# true = no request logs at all (demo mode)
DEMO_MODE=true

# --- Relayer drain protection (spec K, relayer/README.md) ---
PROTECTION_ENABLED=true
QUOTA_PER_DAY=20
# Stamps and payments have separate caps and separate daily budgets (per chain, reset 00:00 UTC; empty = default).
# Payments (POST /pay): per-tx gas cap and daily budget in wei (default 0.1 WBT)
MAX_GAS_PER_PAY=300000
DAILY_BUDGET_WEI=
# Stamps (POST /stamp, ~2.9M gas with the real verifier): per-tx gas cap and daily budget in wei (default 0.1 WBT)
MAX_GAS_PER_STAMP=3500000
STAMP_BUDGET_WEI=
# Stamp relay: RELAYER_PRIVATE_KEY above pays gas; unset = POST /stamp answers 503 (sessions still work)
STAMPS_PER_MINUTE_PER_IP=30
STAMP_MAX_QUEUE=20
STAMP_RECEIPT_TIMEOUT_MS=90000

# --- Arkiv (optional) ---
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
